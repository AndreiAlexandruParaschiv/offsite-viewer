# Public IMS SPA client ID, registered in Adobe Developer Console with this app's
# origin(s) (e.g. http://localhost:5173 for dev, the Amplify URL for prod) as
# allowed redirect URIs. Public client, no secret.
VITE_IMS_CLIENT_ID=

# "prod" (default) or "stage" (ims-na1-stg1 / auth-stg1.services.adobe.com).
VITE_IMS_ENVIRONMENT=prod
